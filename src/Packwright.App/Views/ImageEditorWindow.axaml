<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Packwright.App.Views.ImageEditorWindow"
        Title="Edit image files" Width="980" Height="680" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,6,150,Auto" Margin="12">
    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
      <TextBlock x:Name="ImageText" FontWeight="SemiBold" />
      <WrapPanel>
        <Button x:Name="ReplaceButton" Content="Replace file..." Margin="0,0,8,4" />
        <Button x:Name="AddFileButton" Content="Add file..." Margin="0,0,8,4" />
        <Button x:Name="AddTreeButton" Content="Add folder..." Margin="0,0,8,4" />
        <Button x:Name="NewDirButton" Content="New directory" Margin="0,0,8,4" />
        <Button x:Name="DeleteButton" Content="Delete selected" Margin="0,0,8,4" />
        <Button x:Name="UndoButton" Content="Undo last" Margin="0,0,8,4" />
        <TextBlock Text="Target folder:" VerticalAlignment="Center" Margin="12,0,6,4" />
        <TextBox x:Name="TargetBox" Width="260" Margin="0,0,0,4" />
      </WrapPanel>
    </StackPanel>
    <DataGrid x:Name="EntryGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" />
        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="110" />
      </DataGrid.Columns>
    </DataGrid>
    <GridSplitter Grid.Row="2" />
    <ListBox x:Name="ChangesList" Grid.Row="3" />
    <DockPanel Grid.Row="4" Margin="0,8,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button x:Name="ApplyButton" Content="Apply changes" Classes="accent" />
        <Button x:Name="CancelOpButton" Content="Cancel operation" IsEnabled="False" />
        <Button x:Name="CloseButton" Content="Close" />
      </StackPanel>
      <StackPanel Margin="0,0,12,0">
        <ProgressBar x:Name="EditProgress" Minimum="0" Maximum="100" />
        <TextBlock x:Name="StatusText" Classes="muted" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
