<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Packwright.App.Views.FilesPanel">
  <UserControl.Styles>
    <Style Selector="Arc.spin">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="2" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto" Margin="0,4,0,0">

    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
        <Button x:Name="ExpandButton" Content="Expand" Classes="ghost" Padding="10,6" />
        <Button x:Name="CollapseButton" Content="Collapse" Classes="ghost" Padding="10,6" />
        <Button x:Name="PopOutButton" Content="Open in window" Classes="ghost" Padding="10,6" />
      </StackPanel>
      <TextBox x:Name="FilterBox" Watermark="Filter files and folders..." />
    </DockPanel>

    <Grid x:Name="Body" Grid.Row="1">
      <Border x:Name="TreeHost" Classes="card" Padding="4" ClipToBounds="True">
        <Grid RowDefinitions="*,Auto">
          <TreeView x:Name="Tree" SelectionMode="Multiple" Background="Transparent">
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}">
                <Grid ColumnDefinitions="26,*,Auto" Height="26">
                  <Path Data="{Binding Icon}" Fill="{Binding IconBrush}" Width="16" Height="16" Stretch="Uniform"
                        HorizontalAlignment="Left" Margin="2,0,0,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted" FontSize="11"
                             VerticalAlignment="Center" Margin="14,0,6,0" />
                </Grid>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
          <TextBlock x:Name="EmptyText" Text="No files match." Classes="muted" HorizontalAlignment="Center"
                     VerticalAlignment="Center" IsVisible="False" />
          <Border x:Name="BusyOverlay" Grid.RowSpan="2" IsVisible="False" Background="#99000000" CornerRadius="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
              <Arc Classes="spin" Width="34" Height="34" StartAngle="0" SweepAngle="270" StrokeThickness="4"
                   Stroke="{DynamicResource Accent}" StrokeLineCap="Round" RenderTransform="rotate(0deg)"
                   HorizontalAlignment="Center" />
              <TextBlock x:Name="BusyText" Text="Working..." HorizontalAlignment="Center" />
              <Button x:Name="BusyCancel" Content="Stop" Classes="ghost" HorizontalAlignment="Center" Padding="12,5" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <GridSplitter x:Name="Splitter" Background="Transparent" />

      <Border x:Name="PreviewHost" Classes="card" Padding="0" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*">
          <DockPanel Margin="14,12,10,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
              <Button x:Name="CopyPathButton" Content="Copy path" Classes="ghost" Padding="8,4" />
              <Button x:Name="PrevPageButton" Content="◀" Classes="ghost" Padding="8,4" IsEnabled="False" />
              <Button x:Name="NextPageButton" Content="▶" Classes="ghost" Padding="8,4" IsEnabled="False" />
            </StackPanel>
            <TextBlock x:Name="PreviewTitle" Text="Preview" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock x:Name="PreviewInfo" Grid.Row="1" Classes="muted" FontSize="11" Margin="14,0,14,8" TextTrimming="CharacterEllipsis" />
          <Panel Grid.Row="2" Background="{DynamicResource InputBg}">
            <Image x:Name="PreviewImage" Stretch="Uniform" IsVisible="False" Margin="8" />
            <TextBox x:Name="PreviewText" IsReadOnly="True" AcceptsReturn="True" BorderThickness="0" Background="Transparent"
                     FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="11" />
          </Panel>
        </Grid>
      </Border>
    </Grid>

    <DockPanel Grid.Row="2" Margin="0,8,0,0">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
        <Button x:Name="ExtractFileButton" Content="Extract selected..." />
        <Button x:Name="ExtractAllButton" Content="Extract all..." />
      </StackPanel>
      <TextBlock x:Name="FilesSummary" VerticalAlignment="Center" HorizontalAlignment="Right" Classes="muted" FontSize="12" />
    </DockPanel>
  </Grid>
</UserControl>
