<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Packwright.App.Views"
        x:Class="Packwright.App.Views.MainWindow"
        Title="Packwright" Width="1360" Height="860" MinWidth="900" MinHeight="620"
        Icon="avares://Packwright/Assets/icon.png">
  <Grid x:Name="RootGrid" ColumnDefinitions="236,*">
    <!-- Sidebar -->
    <Border x:Name="Sidebar" Classes="panel" BorderThickness="0,0,1,0" Padding="16,18,16,14">
      <DockPanel LastChildFill="False">
        <Grid x:Name="BrandRow" DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="4,0,0,26">
          <Image x:Name="BrandLogo" Width="42" Height="42" Source="avares://Packwright/Assets/icon.png" HorizontalAlignment="Left" />
          <StackPanel x:Name="BrandText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Packwright" FontWeight="Bold" FontSize="15" />
            <TextBlock x:Name="VersionLabel" Classes="muted" FontSize="11" />
          </StackPanel>
          <Button x:Name="ThemeButton" Grid.Column="2" Classes="ghost" Padding="5" VerticalAlignment="Center" CornerRadius="10">
            <Path x:Name="ThemeIcon" Classes="icon" />
          </Button>
        </Grid>

        <StackPanel DockPanel.Dock="Top">
          <TextBlock x:Name="WorkspaceLabel" Text="WORKSPACE" Classes="section" Margin="6,0,0,8" />
          <RadioButton x:Name="NavLibrary" Classes="nav" GroupName="nav" IsChecked="True">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="icon" Data="M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z" />
              <TextBlock x:Name="NavLibraryText" Text="Library" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavTools" Classes="nav" GroupName="nav">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="icon" Data="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z" />
              <TextBlock x:Name="NavToolsText" Text="Tools" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavTasks" Classes="nav" GroupName="nav">
            <Grid x:Name="TasksRow" ColumnDefinitions="Auto,*,Auto">
              <Path Classes="icon" Data="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z" />
              <TextBlock x:Name="NavTasksText" Grid.Column="1" Text="Tasks" Margin="12,0,0,0" VerticalAlignment="Center" />
              <Border x:Name="TaskBadge" Grid.Column="2" Classes="pill" IsVisible="False" Padding="8,1">
                <TextBlock x:Name="TaskBadgeText" />
              </Border>
            </Grid>
          </RadioButton>
          <RadioButton x:Name="NavHealth" Classes="nav" GroupName="nav">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="icon" Data="M10.5 13H8v-3h2.5V7.5h3V10H16v3h-2.5v2.5h-3V13zM12 2L4 5v6.09c0 5.05 3.41 9.76 8 10.91 4.59-1.15 8-5.86 8-10.91V5l-8-3z" />
              <TextBlock x:Name="NavHealthText" Text="Health" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavLog" Classes="nav" GroupName="nav">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="icon" Data="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V8h16v10zm-2-1h-6v-2h6v2zM7.5 17l-1.41-1.41L8.67 13l-2.58-2.59L7.5 9l4 4-4 4z" />
              <TextBlock x:Name="NavLogText" Text="Log" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <RadioButton x:Name="NavSettings" Classes="nav" GroupName="nav">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="icon" Data="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z" />
              <TextBlock x:Name="NavSettingsText" Text="Settings" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavAbout" Classes="nav" GroupName="nav">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="icon" Data="M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" />
              <TextBlock x:Name="NavAboutText" Text="About" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Content -->
    <Grid Grid.Column="1" RowDefinitions="*,Auto">
      <Panel>
        <v:LibraryView x:Name="LibraryPane" />
        <v:ToolsView x:Name="ToolsPane" IsVisible="False" />
        <v:TasksView x:Name="TasksPane" IsVisible="False" />
        <v:HealthView x:Name="HealthPane" IsVisible="False" />
        <v:LogView x:Name="LogPane" IsVisible="False" />
        <v:SettingsView x:Name="SettingsPane" IsVisible="False" />
        <v:AboutView x:Name="AboutPane" IsVisible="False" />
      </Panel>
      <Border Grid.Row="1" Classes="panel" BorderThickness="0,1,0,0" Padding="18,7">
        <DockPanel>
          <Button x:Name="AuthorLink" DockPanel.Dock="Right" Classes="ghost" Padding="8,2" Margin="14,-3,-8,-3"
                  ToolTip.Tip="github.com/itsmemac/Packwright">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="Built with" Classes="muted" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="♥" Foreground="{DynamicResource Danger}" FontSize="13" VerticalAlignment="Center" />
              <TextBlock Text="by Mac" Classes="muted" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="UpdateLink" DockPanel.Dock="Right" Classes="ghost" Padding="8,2" Margin="14,-3,0,-3" IsVisible="False">
            <TextBlock x:Name="UpdateLinkText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
          </Button>
          <TextBlock x:Name="TaskSummary" DockPanel.Dock="Right" Classes="muted" FontSize="12" />
          <TextBlock x:Name="StatusText" Text="Ready" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
